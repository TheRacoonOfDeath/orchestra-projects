{
    "name": "orchestra/projects",
    "description": "Projects, programs, participation and assignments for the Orchestra plugin suite.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/TheRacoonOfDeath/orchestra-core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/TheRacoonOfDeath/orchestra-library"
        },
        {
            "type": "vcs",
            "url": "https://github.com/TheRacoonOfDeath/orchestra-members"
        },
        {
            "type": "vcs",
            "url": "https://github.com/TheRacoonOfDeath/orchestra-email"
        }
    ],
    "require": {
        "php": "^8.3",
        "yahnis-elsts/plugin-update-checker": "^5.7"
    },
    "require-dev": {
        "orchestra/core": "^0.8",
        "orchestra/email": "^0.1",
        "orchestra/library": "^0.2",
        "orchestra/members": "^0.14",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Orchestra\\Projects\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orchestra\\Projects\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "phpcs",
        "fix": "phpcbf",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "e2e": [
            "Composer\\Config::disableProcessTimeout",
            "tests/e2e/run.sh"
        ]
    }
}
