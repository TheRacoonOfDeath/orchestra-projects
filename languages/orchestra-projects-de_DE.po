"<p>Hello {name},</p><p>your parts in {project} have changed:</p>{changes}"
"<p>All your parts and the sheet music are on the page of the project: {link}"
"</p>"
msgstr ""
"<p>Hallo {name},</p><p>deine Stimmen in {project} haben sich geändert:</"
"p>{changes}<p>Alle deine Stimmen und die Noten findest du auf der Seite des "
"Projekts: {link}</p>"

